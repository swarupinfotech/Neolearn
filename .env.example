# ============================================================
# NeoLearn environment variables (copy to .env.local)
# ============================================================

# ---- Core ---------------------------------------------------
# Base URL of the app (no trailing slash). Used for emails, links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database ----------------------------------------------
# PostgreSQL via Supabase connection pooler (transaction mode, port 6543).
# NOTE: The pooler requires the project ref in the username:
#   <role>.<PROJECT_REF>   e.g. myrole.abcdefghijklmnop
#   Plain "postgres" gets: ENOIDENTIFIER "no tenant identifier provided"
# Use pgbouncer=true for serverless (Vercel) so connections return to the pool.
DATABASE_URL="postgresql://ROLE.PROJECT_REF:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2&connect_timeout=30"

# SQLite is NOT supported by this repo's schema (provider is postgresql).
# See docs/POSTGRES.md for provider notes.

# ---- Auth / security ---------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
# Cookie scope: true in production (https), false for local http.
NODE_ENV=development

# ---- Email (verification / password reset) -----------------
# SMTP settings. If unset, development mode prints codes to server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@neolearn.dev

# ---- Sandbox / code execution ------------------------------
# NeoLearn runs code in a browser-side (worker/WASM) sandbox by default.
# No server execution required. If you later run isolated server workers,
# point them here (currently unsupported -> playground stays client-side).
EXECUTION_BACKEND=client
# EXECUTION_BACKEND=worker
# EXECUTION_API_URL=

# ---- AI Mentor ----------------------------------------------
# Enables /mentor. Uses server-side API (never expose the key to the client).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---- Payments (premium subscriptions) ----------------------
# Server-side verification keys only. Not yet configured = premium BLOCKED.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ---- OAuth (optional) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Admin bootstrap ---------------------------------------
# The first user created with the email below is promoted to admin.
ADMIN_BOOTSTRAP_EMAIL=admin@neolearn.dev